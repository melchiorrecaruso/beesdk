<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="13"/>
    <PathDelim Value="\"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <UseAppBundle Value="False"/>
    </General>
    <BuildModes Active="Release">
      <Item Name="Release" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="LazUtils"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="beeopt.lpr"/>
        <IsPartOfProject Value="True"/>
        <Loaded Value="True"/>
        <UsageCount Value="20"/>
        <IsVisibleTab Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="beeoptmainform.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="MainForm"/>
        <HasResources Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="beeoptcore.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
    <JumpHistory HistoryIndex="-1"/>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="../build/beeopt"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="../bee/source/bee-include;$(ProjOutDir)"/>
      <OtherUnitFiles Value="../bee/source"/>
      <UnitOutputDirectory Value="../build/units"/>
    </SearchPaths>
    <CodeGeneration>
      <Optimizations>
        <OptimizationLevel Value="4"/>
      </Optimizations>
    </CodeGeneration>
    <Linking>
      <LinkSmart Value="True"/>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
